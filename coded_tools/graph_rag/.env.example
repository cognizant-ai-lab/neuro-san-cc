# Neo4j Database Configuration
NEO4J_URI=""
NEO4J_USER="neo4j"
NEO4J_PASSWORD=""

# LLM Provider Configuration
LLM_PROVIDER=openai

# Base URL for the OpenAI compatible instance
# OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# API Key for LLM provider
# OpenAI: https://help.openai.com/en/articles/4936850-where-do-i-find-my-openai-api-key
LLM_API_KEY=OPENAI_API_KEY

# The LLM you want to use for the agents.
LLM_CHOICE=gpt-5-mini

# Embedding Provider Configuration
EMBEDDING_PROVIDER=openai

# Base URL for embedding models
# OpenAI: https://api.openai.com/v1
EMBEDDING_BASE_URL=https://api.openai.com/v1

# API Key for embedding provider
EMBEDDING_API_KEY=OPENAI_API_KEY

# The embedding model you want to use for RAG
# OpenAI example: text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small

# Ingestion-specific LLM (can be different/faster model for processing)
# Leave empty to use the same as LLM_CHOICE
INGESTION_LLM_CHOICE=gpt-5-nano

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8058

# Document Processing
DATA_DIR=/Users/978131/neuro-san-cc/documents  # Directory containing UNFCCC .txt files to ingest

# Chunking Configuration (optimized for Graphiti token limits)
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_CHUNK_SIZE=1500

# Vector Search Configuration
VECTOR_DIMENSION=1536  # For OpenAI text-embedding-3-small
MAX_SEARCH_RESULTS=10

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_MESSAGES_PER_SESSION=100

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# File Processing
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=.md,.txt

# Debug Configuration
DEBUG_MODE=false
ENABLE_PROFILING=false
LLM_CHOICE=gpt-4o-mini
EMBEDDING_DIM=1536

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=OPENAI_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=OPENAI_API_KEY

ENABLE_DEMO_SEARCHES=False
